{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "ES2022.Intl"],
    "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
