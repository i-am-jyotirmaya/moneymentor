# Build selection
RAILWAY_DOCKERFILE_PATH=/apps/web/Dockerfile

# Next.js runtime
PORT=3000

# These NEXT_PUBLIC values are compiled into the browser bundle during the Docker build.
# Set them before deploying and rebuild the service whenever either value changes.
NEXT_PUBLIC_API_BASE_URL=https://replace-with-api-hostname
NEXT_PUBLIC_SUPPORT_EMAIL=replace-with-support-email
