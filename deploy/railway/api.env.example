# Build selection
RAILWAY_DOCKERFILE_PATH=/apps/api/MoneyMentor.Api/Dockerfile

# Runtime and Railway proxy
ASPNETCORE_ENVIRONMENT=Production
PORT=8080
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Railway PostgreSQL reference variables (rename Postgres if your service uses another name)
ConnectionStrings__MoneyMentorDb=Host=${{Postgres.PGHOST}};Port=${{Postgres.PGPORT}};Database=${{Postgres.PGDATABASE}};Username=${{Postgres.PGUSER}};Password=${{Postgres.PGPASSWORD}};SSL Mode=Prefer

# Authentication
Jwt__Issuer=Spndrr
Jwt__Audience=Spndrr.Api
Jwt__SigningKey=replace-with-at-least-32-random-bytes
AuthCookie__Secure=true
AuthCookie__SameSite=None

# Replace both hostnames after Railway creates the public web and API domains
AllowedHosts=replace-with-api-hostname;healthcheck.railway.app
Cors__AllowedOrigins__0=https://replace-with-web-hostname
Product__PublicWebUrl=https://replace-with-web-hostname
Product__SupportEmail=replace-with-support-email

# Invitation email is optional for the first smoke test. Enable only after configuring Resend.
Resend__DispatcherEnabled=false
Resend__ApiKey=
Resend__FromAddress=Spndrr <hello@replace-with-verified-sender-domain>
Resend__ReplyTo=replace-with-support-email

# AI is optional. Deterministic capture, reports, and calculations work without it.
OPENAI_API_KEY=
OPENAI_SAFETY_IDENTIFIER_KEY=
OpenAI__Model=gpt-5.6-terra

# Keep background reports off for the first two-user demo; enable after smoke testing.
JudgementReports__SchedulerEnabled=false
JudgementReports__CalculationWorkerEnabled=false
JudgementReports__NarrationWorkerEnabled=false
JudgementReports__MaxNarrationConcurrency=2
