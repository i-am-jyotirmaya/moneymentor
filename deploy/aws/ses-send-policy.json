{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:REGION:ACCOUNT_ID:identity/example.com",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "hello@example.com"
        }
      }
    }
  ]
}
