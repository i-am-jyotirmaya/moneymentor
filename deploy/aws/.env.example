# Copy to .env on the EC2 host; keep that file private and untracked.
# Use immutable release tags built from the same revision.
API_IMAGE=moneymentor-api:replace-with-release
WEB_IMAGE=moneymentor-web:replace-with-release

# Choose the region of the EC2 instance and future AWS services.
# No AWS keys or profiles are passed to production containers.
AWS_ENABLED=true
AWS_REGION=ap-south-1

# Sibling HTTPS domains pointing at the EC2 host. Hostnames only, no scheme/path.
WEB_HOST=app.spndrr.example
API_HOST=api.spndrr.example
SUPPORT_EMAIL=support@spndrr.example
# Absolute host directory containing fullchain.pem and privkey.pem for both hosts.
TLS_CERTS_PATH=/opt/moneymentor/certs

# Use the existing Neon database; retain TLS and use a direct endpoint for migrations.
# Single quotes preserve literal $ characters in Compose env files.
CONNECTION_STRING='Host=replace-with-neon-direct-host;Port=5432;Database=neondb;Username=replace-with-user;Password=replace-with-password;SSL Mode=VerifyFull;Channel Binding=Require'
JWT_SIGNING_KEY=replace-with-random-signing-key-at-least-32-bytes
# Preserve the current deployment's values when moving an existing installation.
JWT_ISSUER=MoneyMentor
JWT_AUDIENCE=MoneyMentor.Api
REGISTRATION_MODE=RequestOnly

# Verify the sender identity in AWS_REGION and grant the EC2 role ses:SendEmail.
# Approval emails use SES even when the household dispatcher is disabled.
SES_DISPATCHER_ENABLED=false
SES_FROM_ADDRESS=
SES_REPLY_TO=
# Optional SES configuration set for delivery/bounce/complaint events.
SES_CONFIGURATION_SET_NAME=

OPENAI_API_KEY=
OPENAI_SAFETY_IDENTIFIER_KEY=
OPENAI_MODEL=gpt-5.6-terra
JUDGEMENT_REPORT_SCHEDULER_ENABLED=false
JUDGEMENT_REPORT_CALCULATION_ENABLED=false
JUDGEMENT_REPORT_NARRATION_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
