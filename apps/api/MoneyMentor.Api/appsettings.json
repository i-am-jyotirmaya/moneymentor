{
  "AWS": {
    "Enabled": false,
    "Region": ""
  },
  "Registration": {
    "Mode": "RequestOnly"
  },
  "Jwt": {
    "Issuer": "MoneyMentor",
    "Audience": "MoneyMentor.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "AuthCookie": {
    "Secure": true,
    "SameSite": "Strict"
  },
  "Product": {
    "PublicWebUrl": "https://app.spndrr.example",
    "SupportEmail": ""
  },
  "Resend": {
    "DispatcherEnabled": false,
    "RecoveryInterval": "01:00:00",
    "FromAddress": "",
    "ReplyTo": "",
    "ApiKey": ""
  },
  "OpenAI": {
    "Model": "gpt-5.6-terra",
    "TimeoutSeconds": 45,
    "MaxOutputTokens": 2500
  },
  "Jev": {
    "Model": "jev-latest",
    "TimeoutSeconds": 5
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "RateLimits": {
    "AuthenticatedPerMinute": 120,
    "AnonymousPerMinute": 60,
    "SignupsPerHour": 5,
    "AccessRequestsPerHour": 5,
    "LoginsPerFiveMinutes": 10,
    "SessionsPerFiveMinutes": 30,
    "InvitationsPerHour": 10,
    "PrivacyOperationsPerHour": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
