{
  "Jwt": {
    "Issuer": "MoneyMentor",
    "Audience": "MoneyMentor.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "AuthCookie": {
    "Secure": true,
    "SameSite": "Strict"
  },
  "Product": {
    "PublicWebUrl": "https://app.moneymentor.example",
    "SupportEmail": ""
  },
  "Resend": {
    "ApiKey": "",
    "FromAddress": "moneymentor@resend.dev",
    "ReplyTo": "no-reply.moneymentor@resend.dev"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "RateLimits": {
    "AuthenticatedPerMinute": 120,
    "AnonymousPerMinute": 60,
    "SignupsPerHour": 5,
    "LoginsPerFiveMinutes": 10,
    "SessionsPerFiveMinutes": 30,
    "InvitationsPerHour": 10,
    "PrivacyOperationsPerHour": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
