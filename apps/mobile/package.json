{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node ../../scripts/prepare-ocr-assets.mjs mobile && next dev --port 3001",
    "dev": "node ../../scripts/prepare-ocr-assets.mjs mobile && next dev --port 3001",
    "build": "node ../../scripts/prepare-ocr-assets.mjs mobile && next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "sync": "pnpm build && cap sync",
    "android": "pnpm sync && cap open android",
    "ios": "pnpm sync && cap open ios"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor-community/speech-recognition": "7.0.1",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@capacitor/cli": "^8.0.0",
    "@tesseract.js-data/eng": "1.0.0"
  }
}
