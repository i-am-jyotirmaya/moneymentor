{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true, "distribution": "internal", "environment": "development",
      "env": { "APP_VARIANT": "development" }, "android": { "buildType": "apk" }
    },
    "development-simulator": { "extends": "development", "ios": { "simulator": true } },
    "preview": {
      "distribution": "internal", "environment": "preview", "env": { "APP_VARIANT": "preview" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "distribution": "store", "environment": "production", "autoIncrement": true,
      "env": { "APP_VARIANT": "production" }, "android": { "buildType": "app-bundle" }
    },
    "e2e": {
      "withoutCredentials": true, "environment": "preview",
      "env": { "APP_VARIANT": "e2e", "EXPO_PUBLIC_E2E": "1" },
      "android": { "buildType": "apk" }, "ios": { "simulator": true }
    }
  },
  "submit": { "production": { "ios": {} } }
}
