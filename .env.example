POSTGRES_DB=spndrr
POSTGRES_USER=spndrr
POSTGRES_PASSWORD=replace-with-a-long-random-password
API_IMAGE=registry.example/spndrr-api:commit-sha
WEB_IMAGE=registry.example/spndrr-web:commit-sha
OPERATIONS_IMAGE=registry.example/spndrr-operations:commit-sha
CONNECTION_STRING=Host=postgres;Port=5432;Database=spndrr;Username=spndrr;Password=replace-with-a-long-random-password;SSL Mode=Prefer
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
ALLOWED_HOSTS=api.spndrr.example
CORS_ORIGIN=https://app.spndrr.example
PUBLIC_WEB_URL=https://app.spndrr.example
PUBLIC_API_URL=https://api.spndrr.example
SUPPORT_EMAIL=support@spndrr.example
RESEND_DISPATCHER_ENABLED=false
RESEND_API_KEY=re_replace_me
RESEND_FROM_ADDRESS=Spndrr <hello@spndrr.example>
RESEND_REPLY_TO=support@spndrr.example
OPENAI_API_KEY=sk-replace-me
OPENAI_SAFETY_IDENTIFIER_KEY=replace-with-at-least-32-random-bytes
OPENAI_MODEL=gpt-5.6-terra
JUDGEMENT_REPORT_SCHEDULER_ENABLED=false
JUDGEMENT_REPORT_CALCULATION_ENABLED=false
JUDGEMENT_REPORT_NARRATION_ENABLED=false
JUDGEMENT_REPORT_MAX_NARRATION_CONCURRENCY=2
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example:4317
KNOWN_PROXY_IP=10.0.0.10
NEXT_PUBLIC_SUPPORT_EMAIL=support@spndrr.example

# Backup job
DATABASE_URL=postgresql://spndrr:replace-with-a-long-random-password@postgres:5432/spndrr
AGE_RECIPIENT=age1replace_me
RCLONE_REMOTE=remote:spndrr/backups

# Restore verification job
DATABASE_SERVER_URL=postgresql://spndrr:replace-with-a-long-random-password@postgres:5432
AGE_IDENTITY_FILE=/run/secrets/age_identity
